scout-ai=$PWD filter="*.rb *.rake Rakefile *.rdoc *.R *.sh *.js *.haml *.sass *.txt *.conf" {
 README.md
 USER_GUIDE.md
 Rakefile
 chats=chats filter="*"{
  system=system{
   agent
   scout-ai
  }
  refactor=refactor{
   chat
  }
  help=help{
   fine-tunning
   from_pretrained
   previous_response
  }
  test=test{
   agent_chat.rb
   block
   file
   imports
   imports.rb
   prev
   rf.rb
   tool

   save_reponse

   tokens
   patch
   relay

   cpus.rb
  }
  web=web{
   chat
   cmd
   web
  }
  develop=develop{
   agent
   agent_system
   causalLM
   chat
   digest
   finetuning
   json_format
   model
   rf
   scout-ai
   training=training{
    basics
    data.tmp
    intro
    python
    data=data{
     main
     next_token
     test.rb
    }
   }
  }

  huggingface

  test_huggingface

  SGLang

  observatory.rb

  token_count
  token_count.patch
  token_count.info

  introduce

  socialize

  socialize.test

  meta

  meta.tool_call

  meta.work
  meta.revise
  meta.info
  meta.chat_analyst
  meta.plots

  meta.test
  mechanisms_analysis

  prov.test

  prompt.test
  prompt.test.clear
  prompt.test.full

  ask_agents

  test_job

  test_return_path

  documentation

 }
 lib=lib {
  scout-ai.rb
  scout=scout{
   network=network{
    paths.rb
    knowledge_base.rb
    entity.rb
   }
   llm=llm{
    utils.rb
    chat.rb
    chat=chat{
     annotation.rb
     parse.rb
     persist.rb
     process.rb
     process=process{
      clear.rb
      files.rb
      meta.rb
      options.rb
      tools.rb
     }
     prompt.rb
    }
    tools.rb
    tools=tools{
     mcp.rb
     workflow.rb
     knowledge_base.rb
     call.rb
    }

    backends=backends{
     default.rb

     responses.rb
     openai.rb
     ollama.rb
     anthropic.rb
     vllm.rb
     huggingface.rb
     openwebui.rb

     bedrock.rb
     relay.rb
    }

    ask.rb

    embed.rb

    image.rb

    rag.rb

    mcp.rb

    agent.rb
    agent=agent{
     chat.rb
     delegate.rb
     iterate.rb
     workflow.rb
    }

   }
   model=model{
    util=util{
     save.rb
     run.rb
    }
    base.rb

    python=python{
     base.rb
     torch.rb
     torch=torch{
      helpers.rb
      dataloader.rb
      introspection.rb
      load_and_save.rb
     }
     huggingface.rb
     huggingface=huggingface{
      classification.rb
      causal.rb
      causal=causal{
       next_token.rb
      }
     }
    }
   }
  }
 }
 python=python filter="*"{
  scout_ai=scout_ai{
   __init__.py
   agent.py
   chat.py
   data.py
   message.py
   runner.py
   util.py
   huggingface=huggingface{
    data.py
    eval.py
    model.py
    rlhf.py
    train=train{
     __init__.py
     next_token.py
    }
   }
  }
 }
 share=share{
  server=server files="*"{
   chat.html
   chat.js
  }
 }
 doc=doc filter="*"{
  Agent.md
  Agent=Agent{
   AgentWorkflow.md
   Delegation.md
   MultiAgentPatterns.md
   Python.md
  }
  Backends.md
  Chat.md
  Chat=Chat{
   Persistence.md
   PromptStrategies.md
  }
  Commands.md
  Improvements.md
  Model.md
  Overview.md
  Provenance.md
  StartHere.md
  Tools.md
  Tools=Tools{
   KnowledgeBase.md
   MCP.md
   WorkflowTools.md
  }
 }
 SHARED=SHARED filter="*"{
  00_scope_and_themes.md
  01_chat_core.md
  02_prompt_strategies.md
  03_agent_and_delegation.md
  04_agent_workflow.md
  05_backends.md
  06_tools_system.md
  07_provenance.md
  08_multi_agent_patterns.md
  09_coding_philosophy.md
  10_commands.md
  11_synthesis_report.md
  16_validation_report.md
  search_brief.md
 }
 test=test {
  data=data filter="*"{
   person=person{
    identifiers
    brothers
    marriages
    parents
   }
  }
  test_helper.rb
 }
 bin=bin filter="*"{
  scout-ai
 }
 scout_commands=scout_commands filter="*"{
  llm=llm{
   ask
   json
   template
   process
   process_queries
   server
   word
   md
   info
   prov
  }
  agent=agent{
   ask
   kb
   find
  }
  workflow=workflow{
   mcp
  }
 }
}
