scout-ai=$PWD filter="*.rb *.rake Rakefile *.rdoc *.R *.sh *.js *.haml *.sass *.txt *.conf" {
 README.md
 USER_GUIDE.md
 Rakefile
 chats=chats filter="*"{
  system=system{
   agent
   scout-ai
  }
  refactor=refactor{
   chat
  }
  help=help{
   fine-tunning
   from_pretrained
   previous_response
  }
  test=test{
   agent_chat.rb
   block
   file
   imports
   imports.rb
   prev
   rf.rb
   tool

   save_reponse

   tokens
   patch
   relay

   cpus.rb
  }
  web=web{
   chat
   cmd
   web
  }
  develop=develop{
   agent
   agent_system
   causalLM
   chat
   digest
   finetuning
   json_format
   model
   rf
   scout-ai
   training=training{
    basics
    data.tmp
    intro
    python
    data=data{
     main
     next_token
     test.rb
    }
   }
  }

  huggingface

  test_huggingface

  SGLang

  observatory.rb

  token_count
  token_count.patch
  token_count.info

  introduce

  socialize

  socialize.test

  meta

  meta.tool_call

  meta.work
  meta.revise
  meta.info
  meta.chat_analyst
  meta.plots

  meta.test
  mechanisms_analysis

  prov.test

  prompt.test
  prompt.test.clear
  prompt.test.full

  ask_agents

  test_job

  test_return_path

  documentation

  promot_strategies

  provenance_and_accounting

  test.meta

  parse_meta

  fix_info

  read_job

  repeated_tool_calls

  provenance
 }
 lib=lib {
  scout-ai.rb
  scout=scout{
   network=network{
    paths.rb
    knowledge_base.rb
    entity.rb
   }
   llm=llm{
    utils.rb
    chat.rb
    chat=chat{
     annotation.rb
     parse.rb
     persist.rb
     process.rb
     prompt.rb
     prompt=prompt{
      shorten_tools.rb
      shorten_tools_epoch.rb
     }
     provenance.rb
     process=process{
      clear.rb
      files.rb
      meta.rb
      options.rb
      tools.rb
     }
    }
    tools.rb
    tools=tools{
     mcp.rb
     workflow.rb
     knowledge_base.rb
     call.rb
    }

    backends=backends{
     default.rb

     responses.rb
     openai.rb
     ollama.rb
     anthropic.rb
     vllm.rb
     huggingface.rb
     openwebui.rb

     bedrock.rb
     relay.rb
    }

    ask.rb

    embed.rb

    image.rb

    rag.rb

    mcp.rb

    agent.rb
    agent=agent{
     chat.rb
     delegate.rb
     iterate.rb
     workflow.rb
    }

   }
   model=model{
    util=util{
     save.rb
     run.rb
    }
    base.rb

    python=python{
     base.rb
     torch.rb
     torch=torch{
      helpers.rb
      dataloader.rb
      introspection.rb
      load_and_save.rb
     }
     huggingface.rb
     huggingface=huggingface{
      classification.rb
      causal.rb
      causal=causal{
       next_token.rb
      }
     }
    }
   }
  }
 }
 python=python filter="*"{
  scout_ai=scout_ai{
   __init__.py
   agent.py
   chat.py
   data.py
   message.py
   runner.py
   util.py
   huggingface=huggingface{
    data.py
    eval.py
    model.py
    rlhf.py
    train=train{
     __init__.py
     next_token.py
    }
   }
  }
 }
 share=share{
  server=server files="*"{
   chat.html
   chat.js
  }
 }
 doc=doc filter="*"{
  Model.md
  Improvements.md
  StartHere.md
  user=user{
   BuildingAgents.md
   Cookbook.md
   CoreConcepts.md
   Delegation.md
   GettingStarted.md
   ManagingContext.md
   MultiAgentWorkflows.md
   Python.md
   RunningInference.md
   ToolCalling.md
   WritingChats.md
  }
  developer=developer{
   Architecture.md
   Backends.md
   ChatLifecycle.md
   DelegationInternals.md
   DesignPrinciples.md
   PromptProcessing.md
   Provenance.md
  }
 }
 research=research filter="*"{
  agent-delegation-analysis.md
  agent-workflow-analysis.md
  backends-analysis.md
  chat-core-analysis.md
  coding-philosophy-analysis.md
  commands-analysis.md
  multi-agent-patterns-analysis.md
  prompt-strategies-analysis.md
  provenance-analysis.md
  synthesis-report.md
  tools-system-analysis.md
 }
 test=test {
  data=data filter="*"{
   person=person{
    identifiers
    brothers
    marriages
    parents
   }
  }
  scout=scout{
   llm=llm{
    test_agent.rb
    test_ask.rb
    test_chat.rb
    test_embed.rb
    test_mcp.rb
    test_parse.rb
    test_rag.rb
    test_tools.rb
    test_utils.rb
    chat=chat{
     test_parse.rb
     test_process.rb
     process=process{
      test_meta.rb
      test_normalize_usage.rb
     }
    }
    backends=backends{
     test_anthropic.rb
     test_bedrock.rb
     test_huggingface.rb
     test_ollama.rb
     test_openai.rb
     test_openwebui.rb
     test_relay.rb
     test_responses.rb
    }
   }
  }
  test_helper.rb
 }
 bin=bin filter="*"{
  scout-ai
 }
 scout_commands=scout_commands filter="*"{
  llm=llm{
   ask
   json
   template
   process
   process_queries
   server
   word
   md
   info
   prov
  }
  agent=agent{
   ask
   kb
   find
  }
  workflow=workflow{
   mcp
  }
 }
}
