#!/usr/bin/env ruby
# frozen_string_literal: true

require 'scout-ai'
require 'json'
require 'set'
require 'tempfile'

cmd = $previous_commands ?
  "scout #{$previous_commands.any? ? "#{$previous_commands * ' '} " : ''}#{File.basename(__FILE__)}" :
  $PROGRAM_NAME

options = SOPT.setup <<~EOF

Examine the provenance of a chat or workflow job

$ #{cmd} [<options>] <filename>

-h--help Print this help
-c--component Show per-component direct costs (direct=) instead of subtree evidence closures (evidence=)
-f--flow Print a compact provenance flow
-l--long Show full filesystem paths instead of abbreviated names
-e--evidence List the deduplicated direct inference events and their evidence
--live Show live work: in-flight inference from the .jobs sidecar, agent logs and society trees, beyond the captured report
--dot* Write the flow as Graphviz DOT
-p--plot* Render the flow as svg, png, or pdf
--timeline* Render the execution timeline as svg, png, pdf, or dot

Default-tree numbers are evidence= subtree-deduplicated closures: they overlap
between nodes and are never per-part cost.  Job nodes add delta= (direct tokens
of the persisted chat-typed result, the accounting delta).  The root footer
always prints the authoritative deduplicated_total, in both modes; --component
relabels the node numbers direct=.  cache= carries the cache-hit share of
prompt (cct/pt); the root footer adds fresh= (prompt not served from cache,
including cache_write) and cache_write= (Anthropic cache-write tokens).
Per-job delta= values sum to the root total on continuation chains but not on
general DAGs.
EOF
if options[:help]
  defined?(scout_usage) ? scout_usage : puts(SOPT.doc)
  exit 0
end

component = options.delete(:component)
flow = options.delete(:flow)
dot_file = options.delete(:dot)
plot_file = options.delete(:plot)
timeline_file = options.delete(:timeline)
long = options.delete(:long)
evidence = options.delete(:evidence)
live = options.delete(:live)
filename = ARGV.first
raise MissingParameterException, :filename if filename.nil?

# One parse-once cache for the whole CLI run (see
# Chat.provenance_chat_load): the initial traversal, the token-event
# collector and this script's own node computations then share a single
# Chat object per resolved path.
Chat.open_provenance_run_cache

# A persisted Step always has an info sidecar. A .files directory alone is NOT
# evidence: saved agent chats carry one too. Explicitly loading the Step after
# this evidence check avoids treating every readable chat as a job.
job_evidence = Open.exists?(filename + '.info')
root_type = job_evidence ? :job : :chat
root = root_type == :job ? Step.load(filename) : Path.setup(File.expand_path(filename))
warnings = []

# With --live the run must still work when the root chat is not yet on disk:
# the caller's save_file is flushed only at round end, so a chat observed
# MID-round exists only as its `<base>.jobs` sidecar (transient workload
# snapshot) plus the child job tree. The live section does not depend on the
# transcript at all, so tolerate an absent root here instead of failing.
records =
  if live && root_type == :chat && !File.file?(filename)
    []
  else
    Chat.traverse_provenance(
      root,
      root_type: root_type,
      on_error: lambda do |error, kind, object, relation, reference|
        warnings << {
          error: error,
          kind: kind,
          object: object,
          relation: relation,
          reference: reference
        }
      end
    ).to_a
  end

# ------------------------------------------------------------------
# Build graph: nodes keyed by [kind, path], edges as {from, to, relation}
# ------------------------------------------------------------------
nodes = {}
edges = []
records.each do |kind, object, parent_kind, parent, relation, first_visit, _detail|
  key = Chat.provenance_key(kind, object)
  nodes[key] ||= { kind: kind, object: object, path: Chat.provenance_path(kind, object) }
  next unless parent

  parent_key = Chat.provenance_key(parent_kind, parent)
  nodes[parent_key] ||= {
    kind: parent_kind,
    object: parent,
    path: Chat.provenance_path(parent_kind, parent)
  }
  edge = { from: parent_key, to: key, relation: relation, first_visit: first_visit }
  edges << edge unless edges.any? do |other|
    other[:from] == edge[:from] && other[:to] == edge[:to] && other[:relation] == relation
  end
end
root_key = Chat.provenance_key(root_type, root)

# ------------------------------------------------------------------
# Live section machinery (--live): render the unified live report
# ------------------------------------------------------------------
# Captured ids: the job references the forensic report already resolves.
# Taken from the SAME traversal records this script renders - :job edges
# (chat.jobs metas) and :agent_job edges (receipts) - so the live section
# never re-defines "captured"; whatever the normal report shows as a job
# node counts as captured.  Both the Step#path form and the raw reference
# string form are included because live entries carry the sidecar's short
# form while edges carry Step objects.
captured_references = records.collect do |kind, object, parent_kind, _parent, relation, _first|
  next nil unless parent_kind == :chat && kind == :job
  next nil unless relation == :job || relation == :agent_job
  [object.respond_to?(:path) ? object.path.to_s : object.to_s]
end.compact.flatten

# One renderer for both call sites (appended section after the normal
# report, and the --live-only fallback below), so the two cannot diverge.
# Renders nothing - not even the header - when nothing is live: `--live`
# output then equals the normal report exactly.
render_live_section = lambda do |live_base|
  report = Chat.live_report(live_base, captured: captured_references)
  entries = report[:entries]
  next if entries.empty?

  puts
  puts 'Live work (in-flight while this prov run executes)'
  puts '================================================='
  # Stable order: kind first (inference before dangling_job before the
  # rest - LIVE_KIND_ORDER below), then identifying path.
  LIVE_KIND_ORDER = {inference: 0, dangling_job: 1, agent_activity: 2, workload_context: 3}
  entries.sort_by! do |entry|
    [LIVE_KIND_ORDER[entry[:kind]] || 99, entry[:path].to_s]
  end
  entries.each do |entry|
    kind = LIVE_KIND_LABEL[entry[:kind]] || entry[:kind].to_s
    # The identifying reference: the job's short path when the entry has
    # one, else the agent-log path.
    reference = entry[:reference].to_s
    reference = entry[:agent_file].to_s if reference.empty?
    detail = entry[:reason] || entry[:state]
    detail = 'crashed/stale' if detail == :crashed
    detail = detail.to_s if detail.is_a?(Symbol)
    sources = [entry[:source]].flatten.compact.uniq.collect(&:to_s) * ','
    extra = []
    extra << "log=#{entry[:agent_log]}" if entry[:agent_log] && entry[:agent_log] != reference
    extra << "info=#{entry[:status]}" if entry[:status]
    line = format('  %-12s %-40s %-14s %-18s', kind, reference, detail, sources)
    line += ' ' + extra.join(' ') unless extra.empty?
    puts line
  end
end
LIVE_KIND_LABEL = {inference: 'chat_task', dangling_job: 'dangling_job',
                   agent_activity: 'agent_active', workload_context: 'workflow'}

# Job nodes whose jobname (Step#clean_name) is not the `Default` sentinel
# label with the jobname instead of the input-hash excerpt.  Jobnames are not
# unique: a conversation continued twice shares one jobname, so names used by
# more than one job node of this tree are disambiguated by appending the short
# hash.  Counted once here, before any rendering, so tree, flow and dot modes
# disambiguate identically.  A constant (like RELATION_ORDER below) because
# node_label is a def, and defs cannot close over top-level locals.
# An empty graph (records == [], the --live-only case for a chat that is not
# yet on disk) has nothing to label or render: skip the pre-render passes and
# every rendering mode below rather than dereferencing a missing root node.
if nodes.empty?
  # --live with a chat that is not yet on disk: no transcript, but the
  # sidecar, the agent save file and the job tree are real evidence.
  # Routed through the same shared renderer the normal path appends, so
  # the two paths cannot diverge.
  render_live_section.call(root) if live
  exit 0
end

JOB_NAME_COUNTS = Hash.new(0)
nodes.each_value do |node|
  next unless node[:kind] == :job
  job = node[:object]
  name = job.respond_to?(:clean_name) ? job.clean_name : nil
  JOB_NAME_COUNTS[name] += 1 if name && name != Task::DEFAULT_NAME
end

# Society conversations saved under a `.society` directory (agent.society at
# the top level, plain `society` or `<name>.society` for nested saves) label
# with their `<Agent>/<conversation>` pair instead of the path.  The pair is
# taken after the LAST marker segment, so a nested save is labeled by its own
# agent/conversation rather than the outer one.  Pairs are not unique either:
# the same conversation may be saved under two parents, so pairs used by more
# than one chat node are disambiguated by appending the short path digest
# (the same digest the flow id column shows for chats).  Counted in the same
# pre-render pass as the jobname counts so tree, flow and dot modes label
# identically.  A constant for the counts, like JOB_NAME_COUNTS above,
# because node_label is a def and defs cannot close over top-level locals.
def society_label_pair(path)
  segments = path.split(File::SEPARATOR)
  marker = segments.rindex do |segment|
    segment == 'society' || segment.end_with?('.society')
  end
  return nil unless marker
  agent, conversation = segments.values_at(marker + 1, marker + 2)
  agent && conversation ? "#{agent}/#{conversation}" : nil
end

SOCIETY_LABEL_COUNTS = Hash.new(0)
nodes.each_value do |node|
  next unless node[:kind] == :chat
  pair = society_label_pair(node[:path])
  SOCIETY_LABEL_COUNTS[pair] += 1 if pair
end

# Adjacency: parent -> children, sorted for readability
adjacency = Hash.new { |h, k| h[k] = [] }
edges.each do |edge|
  adjacency[edge[:from]] << edge
end
RELATION_ORDER = { dependency: 0, log: 1, job: 2, agent_job: 3, result: 4 }
adjacency.each_value do |children|
  children.sort_by! { |e| RELATION_ORDER[e[:relation]] || 99 }
end

# ------------------------------------------------------------------
# Token computation
# ------------------------------------------------------------------
chat_cache = {}

# Direct tokens for a single node:
#   chat  -> its own direct inference tokens
#   job   -> sum of tokens from its direct log chats (agent.chat + society chats)
direct_tokens = lambda do |key|
  node = nodes[key]
  if node[:kind] == :chat
    chat = chat_cache[node[:path]] ||= Chat.provenance_chat_load(node[:path])
    Chat.token_totals([chat])
  else
    logs = edges.select { |e| e[:from] == key && e[:relation] == :log }
                .collect { |e| nodes[e[:to]][:path] }.uniq
    chats = logs.collect { |path| chat_cache[path] ||= Chat.provenance_chat_load(path) }
    Chat.token_totals(chats)
  end
rescue => error
  warnings << { error: error, kind: node[:kind], object: node[:object], relation: :tokens }
  Chat::TOKEN_KEYS.each_with_object({}) { |name, totals| totals[name.to_sym] = 0 }
end
# Per-job accounting delta: the direct tokens of the job's persisted
# chat-typed result (Chat.job_result_chat_file).  This is the
# receipt-defined accounting object - the new chat the job returned - so on a
# continuation chain the per-job deltas sum to the root deduplicated_total
# while every ancestor's evidence= closure stays cumulative.  Jobs whose
# result is not chat-typed omit the field (nil, never zero).
delta_cache = {}
delta_tokens = lambda do |key|
  return delta_cache[key] if delta_cache.key?(key)
  node = nodes[key]
  delta_cache[key] = if node[:kind] == :job
    file = Chat.job_result_chat_file(node[:object])
    file ? Chat.token_totals([chat_cache[Chat.provenance_path(:chat, file)] ||= Chat.provenance_chat_load(file)]) : nil
  end
rescue => error
  warnings << { error: error, kind: node[:kind], object: node[:object], relation: :delta }
  delta_cache[key] = nil
end

# ------------------------------------------------------------------
# Receipt (agent_meta) evidence: delegated inference events embedded in
# function_call_output envelopes.  Problems are collected, never fatal.
# ------------------------------------------------------------------
receipt_warnings = []
token_events = nil
token_events_for = lambda do
  return token_events unless token_events.nil?
  token_events = begin
    Chat.provenance_token_events(root, warnings: receipt_warnings)
  rescue => error
    warnings << { error: error, kind: root_type, object: root, relation: :tokens }
    []
  end
end

def receipt_evidence(event)
  event[:evidence].select { |evidence| evidence[:origin] == :agent_meta }
end

# Receipt evidence grouped by the chat file that carries the envelope; used
# for the one-line delegated annotations and to decide whether scope lines
# are needed in component mode.
receipt_events_by_source = Hash.new { |hash, key| hash[key] = [] }
has_receipt_evidence = false
token_events_for.call.each do |event|
  next if receipt_evidence(event).empty?
  has_receipt_evidence = true
  receipt_evidence(event).collect { |evidence| evidence[:source] }.compact.uniq.each do |source|
    receipt_events_by_source[source] << event
  end
end

# Aggregate tokens: provenance-aware totals of the subtree reachable from the
# node.  Direct inference events are deduplicated by identity, so usage that
# exists only inside agent_meta receipts (delegated children whose logs were
# never saved) is included without double counting.
aggregate_cache = {}
aggregate_tokens = lambda do |key|
  return aggregate_cache[key] if aggregate_cache.key?(key)
  node = nodes[key]
  subtree = node[:kind] == :job ? node[:object] : node[:path]
  aggregate_cache[key] = Chat.provenance_token_totals(subtree, warnings: receipt_warnings)
rescue => error
  Chat::TOKEN_KEYS.each_with_object({}) { |name, totals| totals[name.to_sym] = 0 }
end

# Whole-tree totals per scope; only meaningful when receipts exist.
scope_totals = lambda do |scope|
  Chat.provenance_token_totals(root, scope: scope, warnings: receipt_warnings)
rescue => error
  Chat::TOKEN_KEYS.each_with_object({}) { |name, totals| totals[name.to_sym] = 0 }
end

# Select mode: aggregate (default) or component (direct)
node_tokens = component ? direct_tokens : aggregate_tokens

# ------------------------------------------------------------------
# Visibility: which nodes should be shown?
# ------------------------------------------------------------------
# Hidden nodes are skipped entirely — not printed and not traversed.
#   - result-relation chats: they duplicate the job node and create cycles
#   - top-level agent.chat log file: its cost is subsumed by the parent job.
#     The root copy of the agent conversation sits directly under the files
#     dir (<job>.files/agent.chat): any basename agent.chat whose parent is a
#     `<something>.files` directory is such a copy.  NESTED society chats
#     (agent.society/<agent>/<conv>/agent.chat) are real independent inferences
#     and must be shown.  The legacy `.files/log` tree is no longer traversed
#     at all.
def top_level_agent_chat?(path)
  return false unless File.basename(path) == 'agent.chat'
  parent = File.dirname(path)
  parent.end_with?('.files')
end

def hidden_node?(node, relation)
  return true if relation == :result
  return true if relation == :log && top_level_agent_chat?(node[:path])
  false
end

# ------------------------------------------------------------------
# Formatting helpers
# ------------------------------------------------------------------
# `qualifier` names the total field after what it measures so a number can
# never be read as a different quantity: `evidence` (default tree; subtree
# deduplicated closure), `direct` (-c; per-component direct tokens),
# `deduplicated_total` (root footer; the authoritative cost).  `events`
# appends the deduplicated event count where it is already computed (the
# footer), and `delta` inserts the job's result-chat delta right after it.
#
# Canonical field order, identical for node lines and the footer: qualifier
# total, [delta=], then the prompt axis `prompt= cache=<abs>@<rate> [fresh=]
# [cache_write=]`, then generation `cont= reason=`.  `footer: true` adds the
# run-level economics (`fresh=`, `cache_write=`) that do not belong to a node
# label.  The rate is always computed from RAW integer totals
# (`100.0 * cct / pt`): humanized values round at K/M boundaries and would
# corrupt boundary rates.  `cache=` prints whenever pt is positive, including
# `cache=0@0.0%`; when pt is nil/0 the whole prompt axis is omitted (nothing
# to partition).  A conflicting summed set can yield cct > pt; the raw ratio
# is then printed unclamped and the footer caveat line is the guard that
# labels such a figure best-effort.
def token_str(tokens, qualifier: nil, events: nil, delta: nil, footer: false)
  parts = []
  if tokens[:tt] && tokens[:tt].to_i > 0
    value = Misc.human_number(tokens[:tt])
    value += " (#{events} events)" if events
    parts << "#{qualifier || 'total'}=#{value}"
    parts << "delta=#{Misc.human_number(delta[:tt])}" if delta && delta[:tt].to_i > 0
  end
  pt = tokens[:pt].to_i
  if pt > 0
    cct = tokens[:cct].to_i
    parts << "prompt=#{Misc.human_number(pt)}"
    parts << "cache=#{Misc.human_number(cct)}@#{format('%.1f', 100.0 * cct / pt)}%"
    if footer
      parts << "fresh=#{Misc.human_number(pt - cct)}"
      parts << "cache_write=#{Misc.human_number(tokens[:cwt].to_i)}" if tokens[:cwt] && tokens[:cwt].to_i > 0
    end
  end
  parts << "cont=#{Misc.human_number(tokens[:ct])}" if tokens[:ct] && tokens[:ct].to_i > 0
  parts << "reason=#{Misc.human_number(tokens[:rt])}" if tokens[:rt] && tokens[:rt].to_i > 0
  parts * ' '
end

def report_line(kind, label, tokens, offset: 0, qualifier: nil, delta: nil, events: nil)
  color = kind == :job ? :yellow : :green
  parts = [' ' * (offset * 2)]
  parts << Log.color(color, kind.to_s)
  tok = token_str(tokens, qualifier: qualifier, events: events, delta: delta)
  parts << tok unless tok.empty?
  parts << Log.color(:blue, label.to_s) unless label.to_s.empty?
  parts * ' '
end

def job_short_id(path)
  basename = File.basename(path)

  parts = basename.split('_')
  if parts.length == 2 && parts.last.length > 10
    parts.last[0,8]
  else
    basename
  end
end

def node_label(node, parent_node = nil, root_key = nil, key = nil, long = false)
  path = node[:path]
  return path if long
  if node[:kind] == :job
    job = node[:object]
    workflow = job.info[:workflow] || job.info['workflow']
    task = job.info[:task_name] || job.info['task_name']
    short_id = job_short_id(path)
    # Prefer the jobname over the hash excerpt; `Default` (and any step
    # without a usable name) keeps the historical hash-only label.  Shared
    # jobnames get the short hash appended so the two nodes stay
    # distinguishable in tree/flow/dot output.
    name = job.respond_to?(:clean_name) ? job.clean_name : nil
    if name && name != Task::DEFAULT_NAME
      short_id = JOB_NAME_COUNTS[name] > 1 ? "#{name} #{short_id}" : name
    end
    workflow && task ? "#{workflow}/#{task} #{short_id}" : short_id
  elsif node[:kind] == :chat && (pair = society_label_pair(path))
    # Saved society conversation: show the agent/conversation pair after the
    # last `.society` marker instead of the path.  Layout-based, so it fires
    # for chat- and job-owned societies alike (and in flow/dot, where the
    # parent is unknown).  Non-unique pairs get the short digest appended.
    SOCIETY_LABEL_COUNTS[pair] > 1 ? "society #{pair} (#{Misc.digest(path)[0, 8]})" : "society #{pair}"
  elsif parent_node && parent_node[:kind] == :job && path.include?(parent_node[:path] + '.files/')
    # Log chat under a job: show the path relative to the job's files dir, so
    # agent.society/Direct/harness_test/agent.chat is shown shortened.
    # Derive files dir from parent_node path (which is the realpath) to avoid
    # symlink-resolution mismatches between the Step object and node path.
    parent_files_dir = parent_node[:path] + '.files'
    rel = Misc.path_relative_to(parent_files_dir, path)
    rel.nil? || rel.empty? ? File.basename(path) : rel
  elsif key == root_key && node[:kind] == :chat
    # Root chat: show basename
    File.basename(path)
  else
    path
  end
end

# ------------------------------------------------------------------
# Tree rendering (default mode)
# ------------------------------------------------------------------
unless flow || dot_file || plot_file || timeline_file
  printed = Set.new
  print_tree = lambda do |key, offset, relation, parent_key|
    # Skip already-visited nodes entirely (no "(seen)" line)
    return if printed.include?(key)

    node = nodes[key]
    parent_node = parent_key ? nodes[parent_key] : nil

    # Hidden nodes (result chats duplicating a job, top-level agent.chat
    # logs) are not printed, but PROJECTION ONLY: the walk still descends
    # through them so their children are attributed to the current display
    # parent.  This is what makes delegated children of tree-hidden carrier
    # chats visible without adding, removing or rewriting any traversal
    # edge: the :agent_job/:job edges keep pointing at the carrier chat.
    #   - no "printed" slot is consumed, so offsets stay as if the carrier
    #     were not there
    #   - children keep their own incoming relation (delegated-job label)
    #   - the global `printed` set still dedups nodes discovered from
    #     several carriers (first visit wins)
    if hidden_node?(node, relation)
      (adjacency[key] || []).each do |edge|
        print_tree.call(edge[:to], offset, edge[:relation], parent_key)
      end
      return
    end

    printed << key
    label = node_label(node, parent_node, root_key, key, long)
    # A job reached through an agent_meta receipt is a delegated producer.
    label = "delegated-job #{label}" if node[:kind] == :job && relation == :agent_job
    # Both modes: job nodes carry their accounting delta (in -c the
    # direct=/delta= contrast on one line is the question the mode answers).
    delta = node[:kind] == :job ? delta_tokens.call(key) : nil
    puts report_line(node[:kind], label, node_tokens.call(key), offset: offset,
                     qualifier: component ? 'direct' : 'evidence',
                     delta: delta)

    # One compact annotation line for the delegated usage embedded in this
    # chat's own outputs; never one line per receipt.
    if node[:kind] == :chat
      events = receipt_events_by_source.key?(node[:path]) ? receipt_events_by_source[node[:path]] : []
      if events && events.any?
        delegated_tt = events.inject(0) { |sum, event| sum + event[:tokens][:tt].to_i }
        tools = events.flat_map do |event|
          receipt_evidence(event).collect { |evidence| evidence[:tool_name] }
        end.compact.uniq.sort
        annotation = "delegated receipt: #{events.length} events, total=#{Misc.human_number(delegated_tt)}"
        annotation += ", #{tools * ','}" unless tools.empty?
        puts [(' ' * ((offset + 1) * 2)), Log.color(:cyan, annotation)] * ' '
      end
    end

    (adjacency[key] || []).each do |edge|
      print_tree.call(edge[:to], offset + 1, edge[:relation], key)
    end
  end
  print_tree.call(root_key, 0, nil, nil)

  # Root footer (BOTH modes): the one authoritative cost figure, always
  # printed, so -c no longer lacks a global bound.  It carries the run-level
  # economics (deduplicated event count, fresh=, cache_write=) that do not
  # belong to a node label.  It reuses the root aggregate computed for the
  # root node line, which IS the root :deduplicated_total (every deduplicated
  # event once).  Identity conflicts demote it to best-effort; this footer
  # caveat is the single home of the non-authoritative warning in both modes
  # (the -c scope block no longer repeats it).
  conflicts = {}
  root_totals = Chat.provenance_token_totals(root, warnings: receipt_warnings, conflicts: conflicts)
  puts Log.color(:cyan, 'root ') +
    token_str(root_totals, qualifier: 'deduplicated_total',
                       events: token_events_for.call.length, footer: true) + ' ' +
    Log.color(:cyan, '(authoritative cost; per-node evidence=/direct= values overlap)')
  unless conflicts[:authoritative]
    puts Log.color(:red, 'unresolved identity conflicts: ') +
      "#{conflicts[:events]} conflicting event(s); totals above are best-effort (canonical evidence only), not exact"
  end

  # Component mode: make the evidence coverage behind the numbers explicit
  # once receipts are present; chats without receipts keep the previous output
  # exactly.  These are COVERAGE figures, not additive cost categories:
  # chat_evidence + receipt_evidence double counts every event that exists in
  # both a saved child log and a receipt.  Only deduplicated_total is the
  # cost, and receipt_only is the disjoint delegated contribution.
  if component && has_receipt_evidence
    coverage = [[:chat_evidence, 'events with saved chat/log evidence'],
                [:receipt_evidence, 'events inside agent_meta receipts (overlaps chat_evidence)'],
                [:receipt_only, 'receipt evidence with no saved chat/log']]
    coverage.each do |scope, note|
      totals = scope_totals.call(scope)
      rendered = token_str(totals)
      rendered = 'total=0' if rendered.empty?
      puts Log.color(:cyan, "evidence #{scope}:") + ' ' + rendered + ' ' + Log.color(:cyan, "(#{note})")
    end
  end
end

# ------------------------------------------------------------------
# Flow / DOT / SVG mode
# ------------------------------------------------------------------
# Convert root-outward discovery relations into natural data-flow arrows.
flow_edges = edges.collect do |edge|
  case edge[:relation]
  when :job
    { from: edge[:to], to: edge[:from], relation: :result }
  when :agent_job
    { from: edge[:to], to: edge[:from], relation: :delegated_result }
  when :dependency
    { from: edge[:to], to: edge[:from], relation: :dependency }
  else
    edge.slice(:from, :to, :relation)
  end
end.uniq

if flow || dot_file || plot_file || timeline_file
  # Determine visible nodes using same rules as tree mode.
  hidden_keys = Set.new
  nodes.each do |key, node|
    # top-level agent.chat is hidden; nested ones are visible
    hidden_keys << key if node[:kind] == :chat && top_level_agent_chat?(node[:path])
    # result-relation chats that duplicate a job (same path)
    if node[:kind] == :chat
      has_job_same_path = nodes.any? do |k, n|
        n[:kind] == :job && n[:path] == node[:path]
      end
      hidden_keys << key if has_job_same_path
    end
  end
  visible_keys = nodes.keys.reject { |k| hidden_keys.include?(k) }
  visible_set = Set.new(visible_keys)

  # Jobs in dependency order, then chat files
  job_keys = visible_keys.select { |kind, _path| kind == :job }
  predecessors = Hash.new { |hash, k| hash[k] = [] }
  flow_edges.each do |edge|
    predecessors[edge[:to]] << edge[:from] if edge[:relation] == :dependency
  end
  ordered_jobs = []
  visited_jobs = Set.new
  visit_job = lambda do |key|
    next if visited_jobs.include?(key)
    visited_jobs << key
    predecessors[key].sort_by(&:last).each { |dep| visit_job.call(dep) }
    ordered_jobs << key
  end
  job_keys.sort_by(&:last).each { |key| visit_job.call(key) }
  chat_keys = (visible_keys - job_keys).sort_by(&:last)
  ordered_keys = ordered_jobs + chat_keys
  indexes = ordered_keys.each_with_index.to_h { |key, index| [key, index + 1] }

  def short_number(number)
    number = number.to_i
    return format('%.1fM', number / 1_000_000.0) if number >= 1_000_000
    return format('%.1fk', number / 1_000.0) if number >= 1_000
    number.to_s
  end

  if flow
    puts 'Flow'
    puts '===='
    ordered_keys.each do |key|
      node = nodes[key]
      name = node_label(node, nil, nil, key, long)
      tokens = short_number(node_tokens.call(key)[:tt])
      id = node[:kind] == :job ? job_short_id(node[:path]) : Misc.digest(node[:path])[0, 8]
      puts format('[%2d] %-5s %-52s %8s %s', indexes[key], node[:kind].to_s.capitalize, name, tokens, id)
    end
    puts
    flow_edges.each do |edge|
      next unless visible_set.include?(edge[:from]) && visible_set.include?(edge[:to])
      puts format('[%2d] --%-10s--> [%2d]', indexes[edge[:from]], edge[:relation], indexes[edge[:to]])
    end
  end

  if dot_file || plot_file || timeline_file
    # ----------------------------------------------------------------
    # Explanatory execution-flow dot (design: task/prov-svg-design-spec)
    # ----------------------------------------------------------------
    # The dot source explains the run instead of dumping it: labels carry
    # names only, absolute paths live exclusively in tooltip= attributes
    # (graphviz emits one <title> per node, shown on hover in svg), and
    # the machine relation tokens survive only as class= attributes, so
    # the legacy text greps keep passing without printing machine words in
    # the figure.  Shapes keep the historical job=box / chat=note
    # contract; the one deliberate exception is the root, which swaps its
    # note for a dominant inverted box pinned to the source rank.
    ids = ordered_keys.each_with_index.to_h { |key, index| [key, "n#{index}"] }

    # Flow-edge semantics, in data-flow direction:
    #   :delegated_result  job -> parent chat (agent_meta receipt): the
    #                      chat delegated to the job, rendered chat -> job.
    #   :result            job -> chat that references it (meta: job=
    #                      line): also a delegation, rendered chat -> job.
    #                      A :result edge whose endpoints SHARE a path is
    #                      instead the job's own chat-typed result
    #                      (job_result_chat_file returns job.path itself),
    #                      whose node is hidden above as a job duplicate;
    #                      that identity pair is dropped, never drawn.
    #   :log               parent -> chat.  A job parent means the chat is
    #                      an artifact the job produced (produces edge); a
    #                      chat parent is a saved sidecar conversation,
    #                      kept visually secondary (dashed, unlabeled).
    #   :dependency        dependency job -> depending job: the dependency
    #                      produced the job's input.
    delegates = []
    produces = []
    log_edges = []
    dependency_edges = []
    flow_edges.each do |edge|
      from, to, relation = edge.values_at(:from, :to, :relation)
      next unless visible_set.include?(from) && visible_set.include?(to)
      case relation
      when :delegated_result, :result
        next if nodes[from][:path] == nodes[to][:path]
        delegates << {from: to, to: from}
      when :log
        if nodes[from][:kind] == :job
          produces << {from: from, to: to}
        else
          log_edges << {from: from, to: to}
        end
      when :dependency
        dependency_edges << {from: from, to: to}
      end
    end
    delegates.uniq!
    produces.uniq!
    log_edges.uniq!
    dependency_edges.uniq!
    produced_keys = Set.new(produces.collect { |edge| edge[:to] })

    # Continuation chains: jobs sharing a jobname (Step#clean_name) are
    # turns of one conversation continued in place; mtime order is the
    # operative signal, since every turn rewrites a longer chat.  Chains
    # render as flat arcs between consecutive turns, port-pinned south to
    # north so they thread the gap between adjacent turns instead of
    # competing with delegates (west) and produces (east) for ports;
    # constraint=false keeps them from adding rank constraints.
    chain_turns = {}
    continues = []
    chain_members = []
    name_groups = Hash.new { |hash, name| hash[name] = [] }
    visible_keys.each do |key|
      next unless nodes[key][:kind] == :job
      job = nodes[key][:object]
      name = job.respond_to?(:clean_name) ? job.clean_name : nil
      next if name.nil? || name == Task::DEFAULT_NAME
      name_groups[name] << key
    end
    name_groups.each do |name, keys|
      next unless keys.length >= 2
      ordered = keys.sort_by do |key|
        mtime = begin
          File.mtime(nodes[key][:path])
        rescue StandardError
          Time.at(0)
        end
        [mtime, nodes[key][:path]]
      end
      ordered.each_with_index { |key, index| chain_turns[key] = index + 1 }
      ordered.each_cons(2) { |first, second| continues << {from: first, to: second} }
      # Cluster membership: the chain's jobs plus the chats those jobs
      # produced, and nothing else; groups of one stay unclustered.
      members = ordered.reject { |key| key == root_key }
      members += produces.select { |edge| members.include?(edge[:from]) }
                         .collect { |edge| edge[:to] }
      chain_members << [name, members]
    end

    # Job label line 1 keeps the node_label contract (workflow/task plus
    # jobname); chain members trade the shared-name hash disambiguation
    # for an explicit turn number, since the chain itself orders them.
    job_label = lambda do |key|
      turn = chain_turns[key]
      base = node_label(nodes[key], nil, nil, key, long)
      next base unless turn
      job = nodes[key][:object]
      info = job.respond_to?(:info) ? job.info : {}
      workflow = info[:workflow] || info['workflow']
      task = info[:task_name] || info['task_name']
      name = job.respond_to?(:clean_name) ? job.clean_name : nil
      core = name && name != Task::DEFAULT_NAME ? name : job_short_id(nodes[key][:path])
      labelled = workflow && task ? "#{workflow}/#{task} #{core}" : core
      "#{labelled} · turn #{turn}"
    end

    # Outcome before cost: an errored or aborted job shows its outcome and
    # no token line (a zero figure would read as cost information the run
    # does not have).  Healthy jobs omit the token line only when there is
    # nothing to show.
    job_failed = lambda do |key|
      job = nodes[key][:object]
      info = job.respond_to?(:info) ? job.info : {}
      status = info[:status] || info['status']
      %w[error aborted].include?(status.to_s) || (job.respond_to?(:error?) && job.error?)
    end

    qualifier = component ? 'direct' : 'evidence'
    node_lines = ordered_keys.collect do |key|
      node = nodes[key]
      path = node[:path]
      tokens = node_tokens.call(key)[:tt]
      badge = short_number(tokens)
      label =
        if key == root_key
          lines = [node[:kind] == :chat ? File.basename(path) : job_label.call(key),
                   node[:kind] == :chat ? 'Root conversation' : 'Root job',
                   "#{qualifier} #{badge}"]
          lines << '⚠ error' if node[:kind] == :job && job_failed.call(key)
          lines
        elsif node[:kind] == :job
          lines = [job_label.call(key)]
          if job_failed.call(key)
            lines << '⚠ error'
          elsif tokens > 0
            lines << badge
          end
          lines
        elsif society_label_pair(path)
          [node_label(node, nil, nil, key, long), badge]
        else
          [File.basename(path), badge]
        end
      attrs =
        if key == root_key
          'shape=box, class="prov-root", style="rounded,filled,bold", penwidth=2, ' \
          'fillcolor="#1F3A5F", color="#142A45", fontcolor="#FFFFFF", fontsize=14'
        elsif node[:kind] == :job && job_failed.call(key)
          'shape=box, class="prov-job prov-error", style="rounded,filled", ' \
          'fillcolor="#FBE3E3", color="#C0392B", fontcolor="#8E2418"'
        elsif node[:kind] == :job
          'shape=box, class="prov-job", style="rounded,filled", ' \
          'fillcolor="#DCE9F7", color="#4A7EBB", fontcolor="#1F3A5F"'
        elsif society_label_pair(path)
          'shape=note, class="prov-society", style=filled, ' \
          'fillcolor="#F1F3F5", color="#9AA5B1", fontcolor="#5A6672"'
        elsif produced_keys.include?(key)
          'shape=note, class="prov-chat", style=filled, ' \
          'fillcolor="#FFF6DC", color="#C9A227", fontcolor="#5C5236"'
        else
          'shape=note, class="prov-chat", style=filled, ' \
          'fillcolor="#F1F3F5", color="#9AA5B1", fontcolor="#5A6672"'
        end
      format('  %s [%s, label=%s, tooltip=%s];',
             ids[key], attrs, JSON.generate(label * "\n"), JSON.generate(path))
    end

    # Clusters carry the two groupings a reader needs: saved society
    # conversations, and continuation chains with the artifacts their
    # turns produced.  A node joins at most one cluster.
    cluster_blocks = []
    clustered = Set.new
    society_keys = ordered_keys.select do |key|
      key != root_key && nodes[key][:kind] == :chat && society_label_pair(nodes[key][:path])
    end
    unless society_keys.empty?
      clustered.merge(society_keys)
      cluster_blocks << [
        '  subgraph cluster_society {',
        '    label="society chats (root logs)"; labeljust=l; fontsize=10; fontcolor="#5A6672";',
        '    style="rounded,filled"; fillcolor="#F7F9FB"; color="#C7D0D9";',
        '    ' + society_keys.collect { |key| ids[key] } * '; ' + ';',
        '  }'
      ] * "\n"
    end
    chain_members.sort_by { |name, _members| name }.each do |name, members|
      members = members.reject { |key| clustered.include?(key) }
      next if members.empty?
      clustered.merge(members)
      suffix = name.gsub(/[^A-Za-z0-9]/, '_')
      suffix = "chain_#{suffix}" if suffix == 'society'
      cluster_blocks << [
        "  subgraph cluster_#{suffix} {",
        "    label=\"#{name} continuation chain\"; labeljust=l; fontsize=10; fontcolor=\"#1F3A5F\";",
        '    style="rounded,filled"; fillcolor="#F7F9FB"; color="#C7D0D9";',
        '    ' + members.collect { |key| ids[key] } * '; ' + ';',
        '  }'
      ] * "\n"
    end

    # Ranks: the root pinned to the source rank (leftmost in LR), every
    # other job on one shared rank so delegation edges stay short and the
    # chain arcs run flat between siblings; chats take the natural rank
    # behind their producing job.
    rank_blocks = ["  {rank=source; #{ids[root_key]};}"]
    job_ids = ordered_keys.select { |key| nodes[key][:kind] == :job && key != root_key }
                          .collect { |key| ids[key] }
    rank_blocks << "  {rank=same; #{job_ids * '; '};}" unless job_ids.empty?

    edge_lines = []
    delegates.each do |edge|
      edge_lines << format('  %s -> %s [label="delegates", color="#1F3A5F", fontcolor="#1F3A5F", ' \
                           'penwidth=1.6, class="delegated_result"];',
                           ids[edge[:from]], ids[edge[:to]])
    end
    produces.each do |edge|
      edge_lines << format('  %s -> %s [label="produces", color="#4A7EBB", fontcolor="#4A7EBB", ' \
                           'penwidth=1.1, class="dependency"];',
                           ids[edge[:from]], ids[edge[:to]])
    end
    continues.each do |edge|
      edge_lines << format('  %s -> %s [label="continues", color="#6E5AA8", fontcolor="#6E5AA8", ' \
                           'penwidth=1.3, constraint=false, tailport=s, headport=n];',
                           ids[edge[:from]], ids[edge[:to]])
    end
    dependency_edges.each do |edge|
      edge_lines << format('  %s -> %s [label="result", color="#8A93A0", penwidth=0.9, ' \
                           'class="dependency"];',
                           ids[edge[:from]], ids[edge[:to]])
    end
    log_edges.each do |edge|
      edge_lines << format('  %s -> %s [style=dashed, color="#B0B7C3", penwidth=0.9];',
                           ids[edge[:from]], ids[edge[:to]])
    end

    lines = [
      'digraph scout_ai_provenance {',
      '  graph [rankdir=LR, splines="spline", bgcolor="white", pad=0.25, nodesep=0.35, ranksep=0.8, ' \
      'fontname="Helvetica", fontsize=11];',
      '  node [shape=box, style=filled, fontname="Helvetica", fontsize=11, margin="0.14,0.09"];',
      '  edge [fontname="Helvetica", fontsize=9, fontcolor="#6B7280", arrowsize=0.8, color="#8A93A0"];',
      '',
      node_lines,
      '',
      cluster_blocks,
      '',
      rank_blocks,
      '',
      edge_lines,
      '}'
    ].flatten
    dot = lines * "\n"
    Open.write(dot_file, dot) if dot_file

    if plot_file
      extension = File.extname(plot_file).sub(/^\./, '').downcase
      extension = 'svg' if extension.empty?
      raise ParameterException, "Unsupported plot format: #{extension}" unless %w[svg png pdf].include?(extension)
      Tempfile.create(['scout-ai-provenance', '.dot']) do |file|
        file.write(dot)
        file.flush
        raise ScoutException, 'Graphviz dot failed' unless system('dot', "-T#{extension}", file.path, '-o', plot_file.to_s)
      end
    end
  end

  if timeline_file
    # ----------------------------------------------------------------
    # Execution-timeline dot (design: task/prov-svg-timeline-spec).
    # ----------------------------------------------------------------
    # The flow view answers "what delegated what"; this one answers
    # "what happened when".  The vertical axis IS the time axis: nodes
    # are laid out in one single sequence ordered by the time model
    # below, one node per rank, and every semantic edge is emitted with
    # constraint=false so delegation topology can never stretch or
    # reorder the axis.  Only the spine (the chain of consecutive
    # time-neighbours) carries constraint=true.  Node classes, palette
    # and tooltips are reused from the flow view unchanged; the deltas
    # are the time line at label position 2, the transposed ports, the
    # label policy (continues only) and the dropped society cluster.

    # ---- Time model (spec S3), one priority list for order AND badges.
    # Priority 1: the node's own chat file (job: its produced chat, the
    # `produces` target; root: root.chat; society/other chats: their own
    # file) parsed for meta records carrying `timestamp=` ISO-8601
    # fields -> [first, last] interval.  Priority 2: File.mtime of the
    # node path -> point event, no duration.  Tie-break on path, as the
    # mtime ordering of the flow view does.
    produced_chat_of = {}
    produces.each { |edge| produced_chat_of[edge[:from]] = nodes[edge[:to]][:path] }
    parse_iso = lambda do |value|
      Time.iso8601(value.to_s)
    rescue StandardError
      nil
    end
    chat_interval = lambda do |path|
      chat = begin
        Chat.provenance_chat_load(path)
      rescue StandardError
        nil
      end
      return nil unless Array === chat
      stamps = chat.filter_map do |message|
        next unless message[:role].to_s == 'meta'
        parse_iso.call(Chat.parse_meta(message[:content])[:timestamp])
      end
      return nil if stamps.empty?
      [stamps.min, stamps.max]
    end
    node_time = lambda do |key|
      path = nodes[key][:path]
      chat_path = if key == root_key
                    nodes[key][:kind] == :chat ? path : Chat.job_result_chat_file(nodes[key][:object]).to_s
                  elsif nodes[key][:kind] == :job
                    produced_chat_of[key] || Chat.job_result_chat_file(nodes[key][:object]).to_s
                  else
                    path
                  end
      interval = chat_path && Open.exists?(chat_path.to_s) ? chat_interval.call(chat_path) : nil
      if interval
        {start: interval[0], end: interval[1], source: :chat}
      else
        mtime = begin
          File.mtime(path)
        rescue StandardError
          Time.at(0)
        end
        {start: mtime, end: mtime, source: :mtime}
      end
    end
    time_of = {}
    visible_keys.each { |key| time_of[key] = node_time.call(key) }
    # Sequence: one priority list for order AND badges.  The sort key is
    # the full time key [start, end] with the path as final tie-break, so
    # equal starts (cumulative continuation replays share their first
    # stamp) still order by their end, which is exactly the chain
    # (mtime) order the flow view's continuation arcs use.  Ids are
    # numbered along this sequence so n0 is the earliest event.
    sequence = visible_keys.sort_by do |key|
      [time_of[key][:start], time_of[key][:end], nodes[key][:path]]
    end
    ids = sequence.each_with_index.to_h { |key, index| [key, "n#{index}"] }
    sequence_index = sequence.each_with_index.to_h { |key, index| [key, index] }

    # Overlap flags (spec S3): pairwise [start,end) overlap of the
    # node's own event, machine-checkable via class="prov-overlap".
    overlap_keys = Set.new
    sequence.each_with_index do |key, index|
      interval = time_of[key]
      ((index + 1)...sequence.length).each do |other|
        candidate = time_of[sequence[other]]
        next unless interval[:start] < candidate[:end] && candidate[:start] < interval[:end]
        overlap_keys << key
        overlap_keys << sequence[other]
      end
    end

    # ---- Time line rendering (spec S4): `t=<HH:MM:SS>` point, or
    # `t=<HH:MM:SS>→<HH:MM:SS>` interval, optionally ` · <dur>`.
    format_clock = ->(time) { time.getlocal.strftime('%H:%M:%S') }
    format_duration = lambda do |seconds|
      seconds = seconds.to_i
      days, seconds = seconds.divmod(86_400)
      hours, seconds = seconds.divmod(3_600)
      minutes, seconds = seconds.divmod(60)
      return format('%dd', days) if days > 0
      return format('%dh%dm%ds', hours, minutes, seconds) if hours > 0
      return format('%dm%ds', minutes, seconds) if minutes > 0
      format('%ds', seconds)
    end
    time_line = lambda do |key|
      interval = time_of[key]
      clock = format_clock.call(interval[:start])
      return "t=#{clock}" if interval[:source] == :mtime || interval[:end] == interval[:start]
      "t=#{clock}→#{format_clock.call(interval[:end])} · #{format_duration.call(interval[:end] - interval[:start])}"
    end

    # ---- Nodes: flow-view classes with the time line inserted at
    # position 2 (the badge keeps position 3; error jobs keep the
    # no-token-line rule).
    qualifier = component ? 'direct' : 'evidence'
    timeline_node_lines = sequence.collect do |key|
      node = nodes[key]
      path = node[:path]
      tokens = node_tokens.call(key)[:tt]
      badge = short_number(tokens)
      lines =
        if key == root_key
          # Spec S4: root label is name / time line / evidence badge; the
          # flow view's `Root conversation` caption is dropped (line 3 is
          # the badge, per T8).
          [node[:kind] == :chat ? File.basename(path) : job_label.call(key),
           time_line.call(key),
           "#{qualifier} #{badge}"]
        elsif node[:kind] == :job
          base = [job_label.call(key), time_line.call(key)]
          base << '⚠ error' if job_failed.call(key)
          base << badge if job_failed.call(key) == false && tokens > 0
          base
        elsif society_label_pair(path)
          [node_label(node, nil, nil, key, long), time_line.call(key), badge]
        else
          [File.basename(path), time_line.call(key), badge]
        end
      attrs =
        if key == root_key
          'shape=box, class="prov-root", style="rounded,filled,bold", penwidth=2, ' \
          'fillcolor="#1F3A5F", color="#142A45", fontcolor="#FFFFFF", fontsize=14'
        elsif node[:kind] == :job && job_failed.call(key)
          'shape=box, class="prov-job prov-error", style="rounded,filled", ' \
          'fillcolor="#FBE3E3", color="#C0392B", fontcolor="#8E2418"'
        elsif node[:kind] == :job
          'shape=box, class="prov-job", style="rounded,filled", ' \
          'fillcolor="#DCE9F7", color="#4A7EBB", fontcolor="#1F3A5F"'
        elsif society_label_pair(path)
          'shape=note, class="prov-society", style=filled, ' \
          'fillcolor="#F1F3F5", color="#9AA5B1", fontcolor="#5A6672"'
        elsif produced_keys.include?(key)
          'shape=note, class="prov-chat", style=filled, ' \
          'fillcolor="#FFF6DC", color="#C9A227", fontcolor="#5C5236"'
        else
          'shape=note, class="prov-chat", style=filled, ' \
          'fillcolor="#F1F3F5", color="#9AA5B1", fontcolor="#5A6672"'
        end
      attrs = attrs.sub(/class="([^"]*)"/) { %(class="#{$1} prov-overlap") } if overlap_keys.include?(key)
      format('  %s [%s, label=%s, tooltip=%s];',
             ids[key], attrs, JSON.generate(lines * "\n"), JSON.generate(path))
    end

    # ---- Spine (spec S6): consecutive pairs of the time sequence.
    # A pair already joined by a delegates or produces edge reuses that
    # edge as the spine segment (constraint=true); every other pair gets
    # a synthetic class="timeline" edge.  Any semantic edge not reused is
    # demoted to constraint=false, so the time axis stays authoritative:
    # each non-root node ends up with exactly one incoming constraint=true
    # edge and the chain rooted at the root reaches every node in order.
    delegates_of = {}
    produces_of = {}
    delegates.each { |edge| delegates_of[[edge[:from], edge[:to]]] = true }
    produces.each { |edge| produces_of[[edge[:from], edge[:to]]] = true }
    semantic = []
    delegates.each { |edge| semantic << {from: edge[:from], to: edge[:to], kind: :delegates} }
    produces.each { |edge| semantic << {from: edge[:from], to: edge[:to], kind: :produces} }
    continues.each { |edge| semantic << {from: edge[:from], to: edge[:to], kind: :continues} }
    log_edges.each { |edge| semantic << {from: edge[:from], to: edge[:to], kind: :log} }
    dependency_edges.each { |edge| semantic << {from: edge[:from], to: edge[:to], kind: :dependency} }

    spine_reuse = {}
    sequence.each_cons(2) do |first, second|
      pair = [first, second]
      spine_reuse[pair] = :delegates if delegates_of.key?(pair)
      spine_reuse[pair] ||= :produces if produces_of.key?(pair)
    end
    spine_edges = sequence.each_cons(2).collect do |first, second|
      pair = [first, second]
      kind = spine_reuse[pair]
      {from: first, to: second, kind: kind || :synthetic}
    end
    reused_pairs = spine_edges.select { |edge| edge[:kind] != :synthetic }
                              .collect { |edge| [edge[:from], edge[:to]] }.to_set
    side_edges = semantic.reject { |edge| reused_pairs.include?([edge[:from], edge[:to]]) }

    # ---- Temporal clusters (spec S7): one cluster per continuation
    # chain IF AND ONLY IF its members (chain jobs + produced chats)
    # form a contiguous block of the sequence; society chats are never
    # enclosed (they interleave with jobs in time).
    timeline_cluster_blocks = []
    timeline_cluster_members = Set.new
    chain_members.sort_by { |name, _members| name }.each do |name, members|
      members = members.reject { |key| timeline_cluster_members.include?(key) || key == root_key }
      next if members.empty?
      indexes = members.collect { |key| sequence_index[key] }.compact.sort
      next if indexes.empty?
      contiguous = indexes.each_cons(2).all? { |a, b| b == a + 1 }
      next unless contiguous
      timeline_cluster_members.merge(members)
      suffix = name.gsub(/[^A-Za-z0-9]/, '_')
      timeline_cluster_blocks << [
        "  subgraph cluster_#{suffix} {",
        "    label=\"#{name} continuation chain\"; labeljust=l; fontsize=10; fontcolor=\"#1F3A5F\";",
        '    style="rounded,filled"; fillcolor="#F7F9FB"; color="#C7D0D9";',
        '    ' + members.collect { |key| ids[key] } * '; ' + ';',
        '  }'
      ] * "\n"
    end

    # ---- Edges: spine first (constraint=true), then the semantic edges
    # transposed to TB (spec S5).  Ports rotate with the layout: the flow
    # s/n pair becomes e/w, delegates keep their own left-margin face
    # (headport=w) and continues the right corridor (tailport=e
    # headport=w).  Labels survive on continues arcs only.
    timeline_edge_lines = []
    spine_edges.each do |edge|
      case edge[:kind]
      when :synthetic
        timeline_edge_lines << format('  %s -> %s [color="#C7D0D9", penwidth=0.8, class="timeline", constraint=true];',
                                      ids[edge[:from]], ids[edge[:to]])
      when :delegates
        timeline_edge_lines << format('  %s -> %s [color="#1F3A5F", penwidth=1.6, class="delegated_result", headport=w, constraint=true];',
                                      ids[edge[:from]], ids[edge[:to]])
      when :produces
        timeline_edge_lines << format('  %s -> %s [color="#4A7EBB", penwidth=1.1, class="dependency", headport=w, constraint=true];',
                                      ids[edge[:from]], ids[edge[:to]])
      end
    end
    side_edges.each do |edge|
      case edge[:kind]
      when :delegates
        timeline_edge_lines << format('  %s -> %s [color="#1F3A5F", penwidth=1.6, class="delegated_result", headport=w, constraint=false];',
                                      ids[edge[:from]], ids[edge[:to]])
      when :produces
        timeline_edge_lines << format('  %s -> %s [color="#4A7EBB", penwidth=1.1, class="dependency", headport=w, constraint=false];',
                                      ids[edge[:from]], ids[edge[:to]])
      when :continues
        timeline_edge_lines << format('  %s -> %s [label="continues", color="#6E5AA8", fontcolor="#6E5AA8", ' \
                                      'penwidth=1.3, constraint=false, tailport=e, headport=w];',
                                      ids[edge[:from]], ids[edge[:to]])
      when :dependency
        timeline_edge_lines << format('  %s -> %s [color="#8A93A0", penwidth=0.9, class="dependency", constraint=false];',
                                      ids[edge[:from]], ids[edge[:to]])
      when :log
        timeline_edge_lines << format('  %s -> %s [style=dashed, color="#B0B7C3", penwidth=0.9];',
                                      ids[edge[:from]], ids[edge[:to]])
      end
    end

    timeline_lines = [
      'digraph prov_timeline {',
      '  graph [rankdir=TB, splines="spline", bgcolor="white", pad=0.25, nodesep=0.35, ranksep=0.45, ' \
      'fontname="Helvetica", fontsize=11];',
      '  node [shape=box, style=filled, fontname="Helvetica", fontsize=11, margin="0.14,0.09"];',
      '  edge [fontname="Helvetica", fontsize=9, fontcolor="#6B7280", arrowsize=0.8, color="#8A93A0"];',
      '',
      timeline_node_lines,
      '',
      timeline_cluster_blocks,
      '',
      "  {rank=source; #{ids[sequence.first]};}",
      '',
      timeline_edge_lines,
      '}'
    ].flatten
    timeline_dot = timeline_lines * "\n"

    timeline_extension = File.extname(timeline_file).sub(/^\./, '').downcase
    timeline_extension = 'svg' if timeline_extension.empty?
    if timeline_extension == 'dot'
      Open.write(timeline_file, timeline_dot)
    else
      raise ParameterException, "Unsupported timeline format: #{timeline_extension}" unless %w[svg png pdf].include?(timeline_extension)
      Tempfile.create(['scout-ai-provenance', '.dot']) do |file|
        file.write(timeline_dot)
        file.flush
        raise ScoutException, 'Graphviz dot failed' unless system('dot', "-T#{timeline_extension}", file.path, '-o', timeline_file.to_s)
      end
    end
  end
end

# ------------------------------------------------------------------
# Evidence mode: the deduplicated direct inference events behind the totals
# ------------------------------------------------------------------
if evidence
  def evidence_location_str(address)
    return '' unless Array === address && address.any?
    rest = address[1..-1]
    base = address[0].nil? ? '?' : File.basename(address[0].to_s)
    if rest.length >= 3 && rest[1] == :meta
      "#{base}:#{rest[0]}[#{rest[1]},#{rest[2]}]"
    else
      "#{base}:#{rest[0]}"
    end
  end

  def event_id_str(event)
    return event[:inference_id] if event[:inference_id]
    identity = event[:identity]
    # Legacy receipts have no stable id: show the receipt location instead of
    # the raw address array.
    return "receipt=#{evidence_location_str(identity[1])}" if identity.first == :receipt
    identity.length == 2 ? "#{identity[0]}=#{identity[1]}" : identity * '='
  end

  def event_status(event)
    if event[:conflict]
      'conflict (counted once, not authoritative)'
    elsif event[:incomplete_evidence]
      'incomplete evidence'
    elsif event[:deduplication] == :receipt_unresolved
      'legacy unresolved'
    elsif event[:evidence].all? { |item| item[:origin] == :agent_meta }
      'receipt-only'
    else
      'counted once'
    end
  end

  events = token_events_for.call
  puts
  puts 'Direct inference events'
  puts '======================='
  if events.empty?
    puts '(none)'
  else
    # Raw integers here: every number must stay directly comparable with the
    # meta records at the evidence addresses.
    rows = events.collect do |event|
      tokens = event[:tokens]
      token_parts = ["total=#{tokens[:tt].to_i}"]
      token_parts << "prompt=#{tokens[:pt].to_i}" if tokens[:pt].to_i > 0
      token_parts << "cont=#{tokens[:ct].to_i}" if tokens[:ct].to_i > 0
      token_parts << "cache=#{tokens[:cct].to_i}" if tokens[:cct].to_i > 0
      token_parts << "reason=#{tokens[:rt].to_i}" if tokens[:rt].to_i > 0
      evidence_parts = event[:evidence].collect do |item|
        location = evidence_location_str(item[:evidence_address] || item[:meta_address])
        call = item[:call_id] ? " call=#{item[:call_id]}" : ''
        "#{item[:origin]} #{location}#{call}"
      end
      [event_id_str(event), token_parts * ' ', evidence_parts * '; ', event_status(event)]
    end
    puts format('%-26s %-36s %-56s %s', 'Inference ID', 'Tokens', 'Evidence', 'Status')
    rows.each { |row| puts format('%-26s %-36s %-56s %s', *row) }
  end

  receipt_only = events.select { |event| event_status(event) == 'receipt-only' }
  legacy_unresolved = events.select { |event| event[:deduplication] == :receipt_unresolved }

  unless receipt_only.empty?
    puts
    puts "Receipt-only events (no saved child log): #{receipt_only.collect { |event| event_id_str(event) } * ', '}"
  end

  unless legacy_unresolved.empty?
    puts
    puts 'Legacy unresolved events (no inference_id; one per receipt, may overcount):'
    legacy_unresolved.each do |event|
      location = evidence_location_str(event[:evidence].first[:evidence_address])
      puts "  #{event_id_str(event)} at #{location}"
    end
  end

  seen_conflicts = Set.new
  conflicts = receipt_warnings.select do |warning|
    warning[:reason] == :identity_conflict && seen_conflicts.add?(warning[:identity])
  end
  unless conflicts.empty?
    puts
    puts 'Identity conflicts (counted once from canonical evidence; totals containing these are NOT authoritative):'
    conflicts.each do |conflict|
      values = conflict[:values].collect { |field, list| "#{field}=#{Array(list).uniq * '|'}" } * ' '
      puts "  #{conflict[:identity] * '='}: disputed #{conflict[:fields] * ','} (#{values})"
    end
  end

  incomplete = events.select { |event| event[:incomplete_evidence] }
  unless incomplete.empty?
    puts
    puts 'Incomplete evidence (one copy lacks provider_response_id; no conflict):'
    incomplete.each do |event|
      puts "  #{event_id_str(event)}"
    end
  end

  # Agent-job references come straight from the traversal edge details, so no
  # parent chat has to be re-parsed here: the edge already carries the receipt
  # record (call id, tool name, output address, receipt address, reference).
  agent_job_edges = records.select do |kind, _object, parent_kind, _parent, relation, _first|
    relation == :agent_job && parent_kind == :chat && kind == :job
  end
  unless agent_job_edges.empty?
    puts
    puts 'Job projection references (no direct tokens):'
    agent_job_edges.each do |_kind, object, _parent_kind, _parent, _relation, _first, detail|
      detail ||= {}
      location = evidence_location_str(detail[:evidence_address])
      tool = detail[:tool_name] || '?'
      puts "  job=#{object.path} at #{location} call=#{detail[:call_id]} tool=#{tool} (delegated_result edge)"
    end
  end
end

# ------------------------------------------------------------------
# Live workload (--live): the transient <base>.jobs sidecar
# ------------------------------------------------------------------
# The sidecar exists only while Workflow.produce blocks inside a tool round
# of THIS chat's agent, so it is read opportunistically: absent file is a
# non-event and prints nothing (silence, not an error).  Entry
# classification lives in the Chat utility layer (Chat.live_workload), so
# the CLI only renders what the utility resolved.
# --live: the unified live report (sidecar with dependency expansion, the
# root agent's own view, and the society tree), minus everything the
# forensic report above already captured.  Silent when nothing is live.
render_live_section.call(root) if live

warnings.each do |warning|
  error = warning[:error]
  # Receipt problems are reported in detail by the receipt_warnings block
  # below (reason, location, call id); skip the generic line for them.  They
  # are recognized by their structured reference, not by a class: agent_meta
  # diagnostics travel as ordinary ScoutException plus a reference Hash.
  next if warning[:relation] == :agent_job && Hash === warning[:reference] && warning[:reference][:reason]
  Log.warn "Incomplete provenance at #{warning[:kind]} #{warning[:object]} (#{warning[:relation]}): #{error.message}"
end

# Receipt problems and identity conflicts collected by the token collector.
# The same problem may be reported once per aggregate subtree, so printed
# lines are deduplicated by their location.
seen_receipt_warnings = Set.new
receipt_warnings.each do |warning|
  key = warning.values_at(:reason, :source, :output_address, :call_id, :agent_meta_index, :identity)
  next unless seen_receipt_warnings.add?(key)
  if warning[:reason] == :identity_conflict
    Log.warn "identity conflict: #{warning[:identity] * '='} disagrees on #{warning[:fields] * ','}"
  else
    location = warning[:evidence_address] || warning[:output_address]
    Log.warn "agent_meta receipt: #{warning[:reason]} in #{warning[:source]} at #{location.inspect} call=#{warning[:call_id]}#{warning[:message] ? ' - ' + warning[:message] : ''}"
  end
end

# End of the CLI run: drop the parse-once cache so a following run in the
# same process (tests, embedded use) re-parses freshly.
Chat.close_provenance_run_cache
